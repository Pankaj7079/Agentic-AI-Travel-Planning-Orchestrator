BEGIN (implicit)

            SELECT
                dc.id,
                dc.content,
                dc.metadata,
                dc.document_id,
                1 - (dc.embedding <=> :embedding::vector) AS similarity
            FROM document_chunks dc
            JOIN documents d ON d.id = dc.document_id
            WHERE 1=1 
            ORDER BY dc.embedding <=> :embedding::vector
            LIMIT $1
            
