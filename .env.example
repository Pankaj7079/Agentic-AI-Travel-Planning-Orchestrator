# ══════════════════════════════════════════════════════════════════════
# PariKrama Environment Configuration
# Copy this to .env and fill in your values:   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────
APP_NAME=PariKrama
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=change-this-to-a-random-string-in-production
CORS_ORIGINS=["http://localhost:3000"]

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://parikrama:parikrama_dev_2024@localhost:5432/parikrama
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO (S3-compatible) ────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth (optional) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── LLM: Gemini (primary) ───────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# ── LLM: Groq (fallback) ────────────────────────────────────────────
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.1-70b-versatile
GROQ_SECONDARY_MODEL=mixtral-8x7b-32768
GROQ_TIMEOUT_SECONDS=15

# ── LLM Router ──────────────────────────────────────────────────────
LLM_FALLBACK_LATENCY_THRESHOLD_MS=10000
LLM_FALLBACK_ERROR_THRESHOLD=3
LLM_FALLBACK_ERROR_WINDOW_SECONDS=60

# ── Embeddings ───────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── LiveKit (Voice) ──────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Notifications ───────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@parikrama.dev
FCM_CREDENTIALS_PATH=

# ── Monitoring ──────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=parikrama-dev
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Weather API ──────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=
