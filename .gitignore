# ══════════════════════════════════════════════════════════════════════
# PariKrama .gitignore
# ══════════════════════════════════════════════════════════════════════

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/

# ── Environment ──────────────────────────────────────────────────────
.env
.env.local
.env.production
!.env.example

# ── IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Testing ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Node.js (frontend) ──────────────────────────────────────────────
node_modules/
.next/
out/
.vercel

# ── Docker ───────────────────────────────────────────────────────────
# Don't ignore docker configs, just data volumes
docker-compose.override.yml

# ── Data (local only) ───────────────────────────────────────────────
data/knowledge_base/*
!data/knowledge_base/.gitkeep
data/models/*
!data/models/.gitkeep

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Misc ─────────────────────────────────────────────────────────────
*.log
*.bak
*.tmp
celerybeat-schedule
celerybeat.pid
